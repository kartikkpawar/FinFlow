{
  "name": "finflow",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:push": "npm run db:push --workspace=auth-service && npm run db:push --workspace=merchants-service",
    "studio:all": "concurrently --names \"AUTH,MERCHANTS\" --prefix-colors \"cyan,magenta\" \"npm run db:studio --workspace=auth-service\" \"npm run db:studio --workspace=merchants-service\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.2"
    }
  },
  "workspaces": [
    "apps/web",
    "packages/shared",
    "services/api-gateway",
    "services/auth",
    "services/merchants"
  ]
}
